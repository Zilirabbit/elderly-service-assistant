    <string name="material_checklist_apply_title">Hong Kong and Macao permit application</string>
    <string name="material_checklist_apply_tip_1">First-time applications usually require in-person handling at an exit-entry service window. Check local appointment requirements before applying.</string>
    <string name="material_checklist_apply_tip_2">Photo receipt and form requirements may vary by city. Follow the on-site and official platform requirements.</string>
    <string name="material_checklist_renewal_title">Hong Kong and Macao permit endorsement renewal</string>
    <string name="material_checklist_renewal_tip_1">First confirm that your Hong Kong and Macao permit is still valid. Some areas support smart endorsement machines; special cases require a service window.</string>
    <string name="material_checklist_renewal_tip_2">If the document is damaged, expired, or personal information changed, you may need to apply for a new document.</string>
    <string name="material_checklist_border_tip_1">Before departure, check document and endorsement validity. Keep common medicines in original packaging and avoid unknown medicines.</string>
    <string name="material_checklist_border_tip_2">Older adults should save family phone numbers and emergency contacts before travel.</string>
    <string name="material_checklist_uncertain_title">Pre-application checklist</string>
    <string name="material_checklist_uncertain_tip_1">You have a valid Hong Kong and Macao permit, but are unsure whether this trip needs endorsement, replacement, reissue, or another service.</string>
    <string name="material_checklist_uncertain_tip_2">Bring your ID card and Hong Kong and Macao permit to the service window so staff can check your document and endorsement status.</string>
