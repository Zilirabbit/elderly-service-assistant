APP_ENV=dev
APP_NAME=YueTongXin Backend
APP_HOST=0.0.0.0
APP_PORT=8080

# Alibaba Cloud Bailian / DashScope
# Use a key with access to Qwen text, ASR, and optional TTS models.
DASHSCOPE_API_KEY=sk-替换为阿里云百炼DashScopeKey

# Qwen text model for query rewrite and ttsText rewrite
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus
QWEN_TIMEOUT_SECONDS=30

# ASR
ASR_PROVIDER=aliyun_bailian
ASR_MODEL=qwen3-asr-flash
ASR_TIMEOUT_SECONDS=60
ASR_MAX_FILE_SIZE_BYTES=15728640
ASR_LANGUAGE=zh
ASR_ENABLE_DIALECT_AUTO=true

# TTS uses Alibaba Cloud DashScope and caches generated audio on the backend.
TTS_PROVIDER=aliyun_bailian
TTS_CLOUD_ENABLED=true
TTS_DEFAULT_VOICE=longxiaochun_v3
TTS_MODEL=cosyvoice-v3-flash
TTS_ENDPOINT=https://dashscope.aliyuncs.com/api/v1/services/audio/tts/SpeechSynthesizer
TTS_AUDIO_FORMAT=mp3
TTS_SAMPLE_RATE=24000
TTS_SPEECH_RATE=0.9
TTS_VOLUME=70
TTS_TIMEOUT_SECONDS=60
TTS_CACHE_ENABLED=true

# Dify RAG app
DIFY_API_BASE=http://127.0.0.1:8088/v1
DIFY_POLICY_QA_API_KEY=app-替换为新的DifyAppKey
DIFY_RESPONSE_MODE=blocking

# Current backend compatibility names
DIFY_BASE_URL=http://localhost
DIFY_API_KEY=app-替换为新的DifyAppKey
DIFY_CHAT_PATH=/v1/chat-messages
DIFY_TIMEOUT_SECONDS=60

DEFAULT_USER_ID=demo-user-001
